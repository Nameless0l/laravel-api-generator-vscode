{
  "name": "laravel-api-generator",
  "displayName": "Laravel API Generator",
  "description": "%description%",
  "version": "1.2.0",
  "publisher": "Nameless0l",
  "license": "MIT",
  "icon": "media/icon-marketplace.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nameless0l/laravel-api-generator-vscode"
  },
  "homepage": "https://github.com/Nameless0l/laravel-api-generator-vscode#readme",
  "bugs": {
    "url": "https://github.com/Nameless0l/laravel-api-generator-vscode/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/Nameless0l"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "laravel",
    "php",
    "api",
    "crud",
    "rest api",
    "code generator",
    "artisan",
    "eloquent",
    "scaffold",
    "backend",
    "ai",
    "copilot",
    "agent skills",
    "mcp",
    "cursor",
    "claude code"
  ],
  "activationEvents": [
    "workspaceContains:artisan",
    "workspaceContains:*/artisan",
    "workspaceContains:*/*/artisan"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "laravelApiGenerator.generate",
        "title": "%command.generate%",
        "category": "Laravel API Generator",
        "icon": "$(add)"
      },
      {
        "command": "laravelApiGenerator.delete",
        "title": "%command.delete%",
        "category": "Laravel API Generator",
        "icon": "$(trash)"
      },
      {
        "command": "laravelApiGenerator.regenerateFile",
        "title": "%command.regenerateFile%",
        "category": "Laravel API Generator",
        "icon": "$(sync)"
      },
      {
        "command": "laravelApiGenerator.refresh",
        "title": "%command.refresh%",
        "category": "Laravel API Generator",
        "icon": "$(refresh)"
      },
      {
        "command": "laravelApiGenerator.goToRelated",
        "title": "%command.goToRelated%",
        "category": "Laravel API Generator"
      },
      {
        "command": "laravelApiGenerator.diagram",
        "title": "%command.diagram%",
        "category": "Laravel API Generator",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "laravelApiGenerator.showSnippets",
        "title": "%command.showSnippets%",
        "category": "Laravel API Generator",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "laravelApiGenerator.generateFromDatabase",
        "title": "%command.generateFromDatabase%",
        "category": "Laravel API Generator",
        "icon": "$(database)"
      },
      {
        "command": "laravelApiGenerator.generateFromSchema",
        "title": "%command.generateFromSchema%",
        "category": "Laravel API Generator",
        "icon": "$(file-code)"
      },
      {
        "command": "laravelApiGenerator.generateFromMermaid",
        "title": "%command.generateFromMermaid%",
        "category": "Laravel API Generator",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "laravelApiGenerator.generateFromOpenApi",
        "title": "%command.generateFromOpenApi%",
        "category": "Laravel API Generator",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "laravelApiGenerator.describeApi",
        "title": "%command.describeApi%",
        "category": "Laravel API Generator",
        "icon": "$(sparkle)"
      },
      {
        "command": "laravelApiGenerator.addFields",
        "title": "%command.addFields%",
        "category": "Laravel API Generator",
        "icon": "$(diff-added)"
      },
      {
        "command": "laravelApiGenerator.editEntity",
        "title": "%command.editEntity%",
        "category": "Laravel API Generator",
        "icon": "$(edit)"
      },
      {
        "command": "laravelApiGenerator.projectActions",
        "title": "%command.projectActions%",
        "category": "Laravel API Generator",
        "icon": "$(terminal)"
      },
      {
        "command": "laravelApiGenerator.installPackage",
        "title": "%command.installPackage%",
        "category": "Laravel API Generator",
        "icon": "$(cloud-download)"
      }
    ],
    "snippets": [
      {
        "language": "php",
        "path": "./snippets/laravel-api-generator.json"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/laravel-api-generator/SKILL.md",
        "when": "laravelApiGenerator.laravelProject"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "api-schema.json",
        "url": "./schemas/api-schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "api-schema.yaml",
          "api-schema.yml"
        ],
        "url": "./schemas/api-schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "laravelApiGenerator.goToRelated",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && editorLangId == php && laravelApiGenerator.laravelProject"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "laravelApiGenerator",
          "title": "Laravel API Generator",
          "icon": "media/icon-dark.png"
        }
      ]
    },
    "views": {
      "laravelApiGenerator": [
        {
          "id": "laravelApiGenerator.home",
          "type": "webview",
          "name": "%view.home%",
          "initialSize": 3
        },
        {
          "id": "laravelApiGenerator.entities",
          "name": "%view.entities%",
          "initialSize": 2,
          "when": "laravelApiGenerator.laravelProject"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "laravelApiGenerator.entities",
        "contents": "%welcome.installPackage%",
        "when": "!laravelApiGenerator.packageInstalled"
      },
      {
        "view": "laravelApiGenerator.entities",
        "contents": "%welcome.noEntity%",
        "when": "laravelApiGenerator.packageInstalled"
      }
    ],
    "walkthroughs": [
      {
        "id": "laravelApiGenerator.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "installPackage",
            "title": "%walkthrough.installPackage.title%",
            "description": "%walkthrough.installPackage.description%",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:laravelApiGenerator.packageInstalled"
            ]
          },
          {
            "id": "firstApi",
            "title": "%walkthrough.firstApi.title%",
            "description": "%walkthrough.firstApi.description%",
            "media": {
              "markdown": "media/walkthrough/first-api.md"
            },
            "completionEvents": [
              "onCommand:laravelApiGenerator.generate"
            ]
          },
          {
            "id": "fromDatabase",
            "title": "%walkthrough.fromDatabase.title%",
            "description": "%walkthrough.fromDatabase.description%",
            "media": {
              "markdown": "media/walkthrough/from-database.md"
            },
            "completionEvents": [
              "onCommand:laravelApiGenerator.generateFromDatabase",
              "onCommand:laravelApiGenerator.generateFromSchema",
              "onCommand:laravelApiGenerator.generateFromMermaid",
              "onCommand:laravelApiGenerator.generateFromOpenApi",
              "onCommand:laravelApiGenerator.describeApi"
            ]
          },
          {
            "id": "exploreSidebar",
            "title": "%walkthrough.exploreSidebar.title%",
            "description": "%walkthrough.exploreSidebar.description%",
            "media": {
              "markdown": "media/walkthrough/explore.md"
            },
            "completionEvents": [
              "onView:laravelApiGenerator.entities"
            ]
          },
          {
            "id": "agents",
            "title": "%walkthrough.agents.title%",
            "description": "%walkthrough.agents.description%",
            "media": {
              "markdown": "media/walkthrough/agents.md"
            },
            "completionEvents": [
              "onView:laravelApiGenerator.home"
            ]
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "laravelApiGenerator.generate",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.delete",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.regenerateFile",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.refresh",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.goToRelated",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.diagram",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.showSnippets",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.generateFromDatabase",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.generateFromSchema",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.generateFromMermaid",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.generateFromOpenApi",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.describeApi",
          "when": "laravelApiGenerator.laravelProject && laravelApiGenerator.canDescribe"
        },
        {
          "command": "laravelApiGenerator.addFields",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.projectActions",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.editEntity",
          "when": "laravelApiGenerator.laravelProject"
        },
        {
          "command": "laravelApiGenerator.installPackage",
          "when": "laravelApiGenerator.laravelProject && !laravelApiGenerator.packageInstalled"
        }
      ],
      "view/item/context": [
        {
          "command": "laravelApiGenerator.editEntity",
          "when": "view == laravelApiGenerator.entities && viewItem == entity",
          "group": "inline@1"
        },
        {
          "command": "laravelApiGenerator.regenerateFile",
          "when": "view == laravelApiGenerator.entities && viewItem == entity",
          "group": "inline@2"
        },
        {
          "command": "laravelApiGenerator.delete",
          "when": "view == laravelApiGenerator.entities && viewItem == entity",
          "group": "inline@3"
        },
        {
          "command": "laravelApiGenerator.editEntity",
          "when": "view == laravelApiGenerator.entities && viewItem == entity",
          "group": "1_evolve@1"
        },
        {
          "command": "laravelApiGenerator.regenerateFile",
          "when": "view == laravelApiGenerator.entities && viewItem == entity",
          "group": "1_evolve@2"
        },
        {
          "command": "laravelApiGenerator.delete",
          "when": "view == laravelApiGenerator.entities && viewItem == entity",
          "group": "2_remove@1"
        }
      ],
      "view/title": [
        {
          "command": "laravelApiGenerator.generate",
          "when": "view == laravelApiGenerator.entities",
          "group": "navigation@1"
        },
        {
          "command": "laravelApiGenerator.diagram",
          "when": "view == laravelApiGenerator.entities",
          "group": "navigation@2"
        },
        {
          "command": "laravelApiGenerator.refresh",
          "when": "view == laravelApiGenerator.entities",
          "group": "navigation@3"
        },
        {
          "command": "laravelApiGenerator.describeApi",
          "when": "view == laravelApiGenerator.entities && laravelApiGenerator.canDescribe",
          "group": "1_sources@1"
        },
        {
          "command": "laravelApiGenerator.generateFromDatabase",
          "when": "view == laravelApiGenerator.entities",
          "group": "1_sources@2"
        },
        {
          "command": "laravelApiGenerator.generateFromSchema",
          "when": "view == laravelApiGenerator.entities",
          "group": "1_sources@3"
        },
        {
          "command": "laravelApiGenerator.generateFromMermaid",
          "when": "view == laravelApiGenerator.entities",
          "group": "1_sources@4"
        },
        {
          "command": "laravelApiGenerator.generateFromOpenApi",
          "when": "view == laravelApiGenerator.entities",
          "group": "1_sources@5"
        },
        {
          "command": "laravelApiGenerator.projectActions",
          "when": "view == laravelApiGenerator.entities",
          "group": "2_project@1"
        },
        {
          "command": "laravelApiGenerator.showSnippets",
          "when": "view == laravelApiGenerator.entities",
          "group": "2_project@2"
        }
      ],
      "explorer/context": [
        {
          "command": "laravelApiGenerator.generateFromSchema",
          "when": "laravelApiGenerator.laravelProject && resourceFilename =~ /^api-schema\\.(ya?ml|json)$/",
          "group": "laravelApiGenerator@1"
        },
        {
          "command": "laravelApiGenerator.generateFromMermaid",
          "when": "laravelApiGenerator.laravelProject && resourceExtname =~ /^\\.(mmd|mermaid)$/",
          "group": "laravelApiGenerator@2"
        },
        {
          "command": "laravelApiGenerator.generateFromOpenApi",
          "when": "laravelApiGenerator.laravelProject && resourceFilename =~ /(openapi|swagger).*\\.(ya?ml|json)$/i",
          "group": "laravelApiGenerator@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "laravelApiGenerator.generateFromSchema",
          "when": "laravelApiGenerator.laravelProject && resourceFilename =~ /^api-schema\\.(ya?ml|json)$/",
          "group": "laravelApiGenerator@1"
        },
        {
          "command": "laravelApiGenerator.generateFromMermaid",
          "when": "laravelApiGenerator.laravelProject && resourceExtname =~ /^\\.(mmd|mermaid)$/",
          "group": "laravelApiGenerator@2"
        },
        {
          "command": "laravelApiGenerator.generateFromOpenApi",
          "when": "laravelApiGenerator.laravelProject && resourceFilename =~ /(openapi|swagger).*\\.(ya?ml|json)$/i",
          "group": "laravelApiGenerator@3"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "laravelApiGenerator.mcp",
        "label": "Laravel API Generator"
      }
    ],
    "configuration": {
      "title": "Laravel API Generator",
      "properties": {
        "laravelApiGenerator.phpPath": {
          "type": "string",
          "default": "php",
          "description": "%config.phpPath%"
        },
        "laravelApiGenerator.phpCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.phpCommand%"
        },
        "laravelApiGenerator.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.mcpEnabled%"
        },
        "laravelApiGenerator.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fr"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.locale.auto%",
            "%config.locale.en%",
            "%config.locale.fr%"
          ],
          "description": "%config.locale%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "ajv": "^8.20.0",
    "typescript": "^5.3.0"
  }
}
